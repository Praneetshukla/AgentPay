# ==================================================
# AgentPay Gateway - Global Environment Variables
# ==================================================

# Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_string_in_production
CART_HMAC_SECRET=change_this_cart_hmac_secret_key_in_production
TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay_secret
POSTGRES_DB=agentpay_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agentpay:agentpay_secret@localhost:5432/agentpay_db

# Razorpay Test Mode Credentials (NEVER hardcode live keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Agent Configuration
OPENAI_API_KEY=placeholder_openai_api_key
DEFAULT_MODEL=gpt-4o-mini
